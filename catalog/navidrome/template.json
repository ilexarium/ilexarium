{
  "id": "navidrome",
  "version": "2",
  "name": "Navidrome",
  "category": "media",
  "website": "https://www.navidrome.org",
  "web": { "port": 4533 },
  "fields": [
    { "key": "WEB_PORT", "kind": "port", "default": 4533 },
    { "key": "MUSIC_DIR", "kind": "folder", "default": "./music" },
    { "key": "DATA_DIR", "kind": "folder", "default": "./data", "advanced": true },
    {
      "key": "NAVIDROME_VERSION",
      "kind": "version",
      "default": "0.64.2"
    },
    { "key": "USER_ID", "kind": "text", "default": "@account", "advanced": true }
  ],
  "backup": { "mode": "stop", "skip": ["data/cache"] }
}
