{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "resolveJsonModule": true,
    "paths": {
      "@ui/button": ["./src/ui/button/src/index.ts"],
      "@ui/utils": ["./src/ui/utils/src/index.ts"],
      "@ui/input": ["./src/ui/input/src/index.ts"],
      "@ui/label": ["./src/ui/label/src/index.ts"],
      "@ui/card": ["./src/ui/card/src/index.ts"],
      "@ui/alert": ["./src/ui/alert/src/index.ts"],
      "@ui/field": ["./src/ui/field/src/index.ts"],
      "@ui/separator": ["./src/ui/separator/src/index.ts"],
      "@ui/dropdown-menu": ["./src/ui/dropdown-menu/src/index.ts"],
      "@ui/avatar": ["./src/ui/avatar/src/index.ts"],
      "@ui/sonner": ["./src/ui/sonner/src/index.ts"],
      "@ui/sidebar": ["./src/ui/sidebar/src/index.ts"],
      "@ui/sheet": ["./src/ui/sheet/src/index.ts"],
      "@ui/skeleton": ["./src/ui/skeleton/src/index.ts"],
      "@ui/tooltip": ["./src/ui/tooltip/src/index.ts"],
      "@ui/progress": ["./src/ui/progress/src/index.ts"],
      "@ui/badge": ["./src/ui/badge/src/index.ts"],
      "@ui/table": ["./src/ui/table/src/index.ts"],
      "@ui/alert-dialog": ["./src/ui/alert-dialog/src/index.ts"],
      "@ui/select": ["./src/ui/select/src/index.ts"],
      "@ui/message": ["./src/ui/message/src/index.ts"],
      "@ui/bubble": ["./src/ui/bubble/src/index.ts"],
      "@ui/message-scroller": ["./src/ui/message-scroller/src/index.ts"],
      "@ui/marker": ["./src/ui/marker/src/index.ts"],
      "@ui/textarea": ["./src/ui/textarea/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
