// Connection URLs live in prisma.config.ts (Prisma 7); the app connects through @prisma/adapter-pg.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(uuid(7)) @db.Uuid
  username       String          @unique // stored lowercase
  passwordHash   String // self-describing ($scrypt$…); never leaves the server
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)
  /// The profile: shown instead of the username; a contact address, never a sign-in; "en" | "de" | "ar".
  displayName    String?
  email          String?
  language       String?
  avatar         UserAvatar?
  sessions       Session[]
  backupRuns     BackupRun[]
  backupRestores BackupRestore[]
}

/// The profile picture: 600×600, checked by its bytes (WebP, JPEG or PNG). In the database, so backups carry it.
model UserAvatar {
  userId    String   @id @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bytes     Bytes
  /// The type judged from the bytes: "image/webp" | "image/jpeg" | "image/png".
  type      String
  updatedAt DateTime @db.Timestamptz(3)
}

/// Mirrors @nestjs/authentication's SessionRecord. Times come from the package's clock, never DB defaults.
model Session {
  id           String   @id // SHA-256 of the cookie token
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @db.Timestamptz(3)
  expiresAt    DateTime @db.Timestamptz(3) // absolute expiry
  lastActiveAt DateTime @db.Timestamptz(3) // idle timeout
  mfa          String? // unused until 2FA
  metadata     Json? // user agent, IP — for a later "your sessions" page

  @@index([userId])
  @@index([expiresAt])
}

enum AuditOutcome {
  success
  failure
  /// Recorded before a privileged action (fail closed); the outcome follows as a second entry.
  requested
}

model AuditEvent {
  id       String       @id @default(uuid(7)) @db.Uuid
  at       DateTime     @default(now()) @db.Timestamptz(3)
  /// No relation to User: history outlives users.
  userId   String?      @db.Uuid
  username String? // snapshot at the time of the event
  action   String // e.g. 'auth.login' — allowed values listed in code
  outcome  AuditOutcome
  ip       String?      @db.Inet
  details  Json? // never secrets

  @@index([at])
  @@index([userId])
}

enum JobStatus {
  running
  succeeded
  failed
  interrupted
}

/// The backup plan: one row, once set up. The app's source of truth;
/// every change goes to the backup wrapper's `configure`, which writes the timer's copy.
model BackupPlan {
  id           Int      @id @default(1)
  /// The chosen disk's mount point; the repository is <destination>/ilex-backups.
  destination  String
  repositoryId String
  /// { frequency, time }
  schedule     Json
  /// { daily, weekly, monthly }
  retention    Json
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
}

/// What is backed up: the platform (always), an app (by its Compose project), or a folder.
model BackupItem {
  id         String             @id @default(uuid(7)) @db.Uuid
  kind       BackupItemKind
  /// app: its Compose project, its folders (ticked), skips and mode.
  project    String?
  folders    String[]           @default([])
  skip       String[]           @default([])
  /// "stop" | "live"
  mode       String?
  path       String?
  /// Removed from the plan: not backed up any more; its archives stay until deleted.
  removedAt  DateTime?          @db.Timestamptz(3)
  /// Its archives after the latest run's pruning (from the wrapper's results — no listing call).
  archives   String[]           @default([])
  archivesAt DateTime?          @db.Timestamptz(3)
  createdAt  DateTime           @default(now()) @db.Timestamptz(3)
  results    BackupItemResult[]
  restores   BackupRestore[]

  @@index([project])
}

enum BackupItemKind {
  platform
  app
  folder
}

/// One backup run, scheduled or manual, imported from the wrapper's results file (or started here).
model BackupRun {
  /// The wrapper's run id (scheduled) or ours (manual: we start it with this id).
  id          String             @id @db.Uuid
  trigger     BackupTrigger
  /// One item ("Back up now" on it), or null for all.
  itemId      String?            @db.Uuid
  status      BackupRunStatus
  errorCode   String?
  output      String             @default("")
  startedById String?            @db.Uuid
  startedBy   User?              @relation(fields: [startedById], references: [id], onDelete: SetNull)
  startedAt   DateTime           @db.Timestamptz(3)
  finishedAt  DateTime?          @db.Timestamptz(3)
  items       BackupItemResult[]

  @@index([startedAt])
}

enum BackupTrigger {
  scheduled
  manual
}

enum BackupRunStatus {
  running
  ok
  warning
  failed
}

enum BackupStatus {
  ok
  warning
  failed
}

/// An item's part of a run.
model BackupItemResult {
  runId         String       @db.Uuid
  run           BackupRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  itemId        String       @db.Uuid
  item          BackupItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  status        BackupStatus
  errorCode     String?
  archive       String?
  originalBytes BigInt?
  addedBytes    BigInt?
  warnings      String[]     @default([])

  @@id([runId, itemId])
  @@index([itemId])
}

/// A repository check (weekly; monthly with all data read back), from the results file.
model BackupCheck {
  id         String       @id @db.Uuid
  full       Boolean
  status     BackupStatus
  errorCode  String?
  startedAt  DateTime     @db.Timestamptz(3)
  finishedAt DateTime     @db.Timestamptz(3)

  @@index([finishedAt])
}

/// A restore of one archive, run as its own unit; its progress and result from the program's files.
model BackupRestore {
  id                String     @id @default(uuid(7)) @db.Uuid
  itemId            String     @db.Uuid
  item              BackupItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  archive           String
  /// A new folder it went to; null: back where it was.
  targetPath        String?
  /// Back where it was: the folders set aside (the way back), until "Delete previous version".
  setAside          String[]   @default([])
  setAsideDeletedAt DateTime?  @db.Timestamptz(3)
  /// Back where it was, an app that was running: "Apply the restored settings" is offered until used.
  appWasRunning     Boolean    @default(false)
  /// Succeeded with warnings: Borg's, and folders the backup didn't hold.
  warnings          String[]   @default([])
  status            JobStatus
  phase             String?
  errorCode         String?
  output            String     @default("")
  startedById       String?    @db.Uuid
  startedBy         User?      @relation(fields: [startedById], references: [id], onDelete: SetNull)
  startedAt         DateTime   @default(now()) @db.Timestamptz(3)
  finishedAt        DateTime?  @db.Timestamptz(3)

  @@index([startedAt])
}

/// A recovery from the backup disk (ilex-recover, or Backups → Restore Ilexarium), as the backup
/// program's recovery.json tells it: recorded once (its audit entry), its notice until dismissed.
model BackupRecovery {
  /// The recovery's id, from the file.
  id          String    @id @db.Uuid
  recordedAt  DateTime  @default(now()) @db.Timestamptz(3)
  dismissedAt DateTime? @db.Timestamptz(3)
}

enum AlertSeverity {
  warning
  critical
}

/// A health alert: opened when a problem starts, closed by itself
/// when it's gone. One open alert per kind and subject (the watcher writes them one at a time).
/// Closed alerts are kept 30 days.
model Alert {
  id               String        @id @default(uuid(7)) @db.Uuid
  /// `ALERT_KINDS` in @ilex/shared.
  kind             String
  /// The container's name, the mount point or the backup warning.
  subject          String
  severity         AlertSeverity
  /// { catalogId?, percent? } — never logs, values or secrets.
  details          Json          @default("{}")
  openedAt         DateTime      @default(now()) @db.Timestamptz(3)
  closedAt         DateTime?     @db.Timestamptz(3)
  acknowledgedAt   DateTime?     @db.Timestamptz(3)
  /// No relation to User, like the audit log; the username is a snapshot.
  acknowledgedById String?       @db.Uuid
  acknowledgedBy   String?
  /// When it was last sent (opened, or the daily reminder of a critical one).
  lastSentAt       DateTime?     @db.Timestamptz(3)

  @@index([kind, subject, closedAt])
  @@index([closedAt])
}

/// A way alerts are sent besides the app: `email` or `ntfy`. Secrets (the ntfy topic URL and
/// token, the mail password) are one encrypted JSON value (SecretsService, bound to the channel).
model AlertChannel {
  kind          String    @id
  enabled       Boolean
  /// Not secret: the mail server, port, user name, sender and recipient.
  settings      Json      @default("{}")
  secrets       Bytes?
  /// The last message that couldn't be sent; cleared when one is.
  lastProblem   String?
  lastProblemAt DateTime? @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
}

/// Ilexarium's own updates: the switch and the last check — one
/// row, id 1. The release found is kept only while it's newer than the installed version.
model UpdateCheck {
  id                 Int       @id @default(1)
  checkAutomatically Boolean   @default(true)
  checkedAt          DateTime? @db.Timestamptz(3)
  /// An UPDATE_CHECK_ERRORS code: the last check found nothing usable.
  checkError         String?
  /// The newest release's publishing date, whatever its version (a stale folder shows).
  newestPublished    String?
  availableVersion   String?
  availablePublished String?
  /// Plain text, never rendered as HTML.
  availableNotes     String?
}

/// An update started from the app: who started it, and its result once ilex-update wrote it —
/// read from its job file, also after the app's own restart. Written before the installer's
/// database dump, so a rollback keeps it.
model UpdateRun {
  id          String    @id @db.Uuid
  fromVersion String
  toVersion   String
  /// No relation to User, like the audit log; the username is a snapshot.
  userId      String    @db.Uuid
  username    String
  ip          String?
  startedAt   DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt  DateTime? @db.Timestamptz(3)
  /// An UPDATE_OUTCOMES value.
  outcome     String?
  error       String?

  @@index([startedAt])
}
