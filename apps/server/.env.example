# Copy to .env for local development. Validated at startup (src/config/env.schema.ts).

# App database (dev compose: npm run db:up from project/)
DATABASE_URL=postgresql://homelab:homelab-dev@127.0.0.1:5432/homelab

# Whose X-Forwarded-* headers to believe: false (default, no proxy), loopback, or IPs/CIDRs (comma-separated).
# Never "true".
TRUST_PROXY=false

# Where the one-time setup token is written while no user exists.
# Default: .dev/setup-token in development, /var/lib/homelab/setup-token in production.
# SETUP_TOKEN_FILE=

PORT=3000

# The Docker API, through the read-only socket proxy (dev compose: npm run db:up). Never the socket itself.
# DOCKER_HOST=tcp://127.0.0.1:2375

# The key that encrypts services' secrets (32 random bytes, base64; readable by the app's user only).
# Default: .dev/master.key in development (created on first start), /etc/homelab/master.key in production.
# MASTER_KEY_FILE=

# The deploy wrapper's config (the app reads it too): catalog folder, storage roots, reserved ports.
# Default: .dev/wrappers.json in development (created on first start, storage root .dev/srv),
# /etc/homelab/wrappers.json in production (written by the installer).
# WRAPPER_CONFIG_FILE=

# How the root wrapper is run: sudo (production, required) or direct (development: the repo's wrapper, no sudo).
# EXECUTOR_MODE=

# The Linux sign-in (Files, Terminal). Default in development: the dev SSH container
# (127.0.0.1:2222, users anna and bob). To sign in as real users of this machine instead
# (its sshd must accept passwords from 127.0.0.1):
# SSH_PORT=22
# SSH_HOST_KEYS=/etc/ssh
