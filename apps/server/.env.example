# Copy to .env for local development. Validated at startup (src/config/env.schema.ts).

# App database (dev compose: npm run db:up from project/)
DATABASE_URL=postgresql://laris:laris-dev@127.0.0.1:5432/laris

# Whose X-Forwarded-* headers to believe: false, loopback, or IPs/CIDRs (comma-separated).
# Default: false in development, loopback in production (the HTTPS proxy in front, on this machine).
# Never "true".
TRUST_PROXY=false

# Where the one-time setup token is written while no user exists.
# Default: .dev/setup-token in development, /var/lib/laris/setup-token in production.
# SETUP_TOKEN_FILE=

PORT=3000

# The Docker API, through the read-only socket proxy (dev compose: npm run db:up). Never the socket itself.
# DOCKER_HOST=tcp://127.0.0.1:2375

# The key that encrypts services' secrets (32 random bytes, base64; readable by the app's user only).
# Default: .dev/master.key in development (created on first start), /etc/laris/master.key in production.
# MASTER_KEY_FILE=

# The root programs' config (laris-backup, laris-disk; the app reads it too): protected folders,
# the backup and disk parts. Default: .dev/wrappers.json in development (created on first start),
# /etc/laris/wrappers.json in production (written by the installer).
# WRAPPER_CONFIG_FILE=

# How the root programs are started: sudo (production, required: through the signed-in person's
# own sudo, by their helper) or direct (development: the repo's program as you, no sudo).
# ROOT_PROGRAMS=

# The app templates. Default: the repository's catalog/ in development, /opt/laris/catalog in production.
# CATALOG_DIR=

# The Linux sign-in (Files, Terminal). Default in development: the dev SSH container
# (127.0.0.1:2222, users anna and bob). To sign in as real users of this machine instead
# (its sshd must accept passwords from 127.0.0.1):
# SSH_PORT=22
# SSH_HOST_KEYS=/etc/ssh
# …and the helper Laris starts in each Linux session, there (default /opt/laris/libexec/laris-helper.mts):
# LINUX_HELPER=/home/you/laris/system/programs/laris-helper.mts
