{
  "name": "@ilex/i18n",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "Translations shared by web and server: one JSON file per language, plus helpers (languages, plural keys, consistency checks).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*.json": "./messages/*.json"
  },
  "files": [
    "dist",
    "messages"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "^4.1.12"
  }
}
