# /etc/sudoers.d/homelab — REVIEW-REQUIRED (system/CLAUDE.md).
# Install as root:root, mode 0440, after `visudo -cf` accepts it (the installer does both).
#
# The app's user may run exactly one program as root: the deploy wrapper, by absolute path.
# No wildcards, no raw binaries (docker, node) — the wrapper checks its own arguments.
# The wrapper file and its folder must belong to root and be writable only by root: sudo trusts
# the path, so whoever can replace the file runs code as root.
# Never enable log_input (or I/O logging) for this rule: the wrapper's stdin carries services'
# secrets (passwords), which would then be written to sudo's logs in plain text.

Defaults:homelab env_reset, !env_keep, secure_path="/usr/sbin:/usr/bin:/sbin:/bin"

homelab ALL=(root) NOPASSWD: /opt/homelab/libexec/homelab-compose.mts
