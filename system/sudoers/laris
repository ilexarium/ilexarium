# /etc/sudoers.d/laris — REVIEW-REQUIRED (system/CLAUDE.md).
# Install as root:root, mode 0440, after `visudo -cf` accepts it (the installer does both).
#
# The app's user may run exactly three programs as root, by absolute path: the deploy wrapper,
# the backup wrapper and the disk wrapper. No wildcards, no raw binaries (docker, node, borg, mount,
# systemctl) — each wrapper checks its own arguments. The wrapper files (and the backup wrapper's word list beside it) and their folder
# must belong to root and be writable only by root: sudo trusts the path, so whoever can replace
# a file runs code as root.
# Never enable log_input or log_output (I/O logging) for these rules: the deploy wrapper's stdin
# carries services' secrets (passwords), and the backup wrapper's `passphrase` output is the
# backup passphrase — both would then be written to sudo's logs in plain text.

Defaults:laris env_reset, !env_keep, secure_path="/usr/sbin:/usr/bin:/sbin:/bin"

laris ALL=(root) NOPASSWD: /opt/laris/libexec/laris-compose.mts
laris ALL=(root) NOPASSWD: /opt/laris/libexec/laris-backup.mts
laris ALL=(root) NOPASSWD: /opt/laris/libexec/laris-disk.mts
