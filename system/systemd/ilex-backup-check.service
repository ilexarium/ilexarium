# /etc/systemd/system/ilex-backup-check.service — REVIEW-REQUIRED (system/CLAUDE.md).
# A repository check (`borg check`; the first of each month also reads all data back), started by
# ilex-backup-check.timer. Its result goes to its job file in /var/lib/ilex/backups/jobs/.

[Unit]
Description=Ilexarium backup repository check
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/opt/ilex/libexec/ilex-backup.mts check-scheduled
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=24h
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
