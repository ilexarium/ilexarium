# /etc/systemd/system/homelab-backup-check.timer — REVIEW-REQUIRED (system/CLAUDE.md).
# Weekly repository check. Enabled by `homelab-backup configure` once a plan exists.

[Unit]
Description=Homelab backup repository check, weekly

[Timer]
OnCalendar=Sun *-*-* 05:00:00
Persistent=true
RandomizedDelaySec=30min

[Install]
WantedBy=timers.target
