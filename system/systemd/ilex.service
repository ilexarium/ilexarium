# /etc/systemd/system/ilex.service
# The app, as its own unprivileged user. Two kinds of settings:
# the release's — facts about this version's files, below, replaced with every update — and the
# machine's, /etc/ilex/app.env (root:ilex 0640: where it listens, the database password),
# written once by the installer and never by an update.
#
# No NoNewPrivileges, ProtectSystem, PrivateTmp and the like yet. The app starts nothing privileged
# any more: root work runs in the signed-in person's SSH session, through their own sudo.
# They would only narrow what a compromised app can do on the host
# itself, and go in once the install test checks what the app still reads and writes.

[Unit]
Description=Ilexarium
Requires=ilex-platform.service
After=ilex-platform.service network-online.target
Wants=network-online.target

[Service]
User=ilex
Group=ilex
Environment=NODE_ENV=production
Environment=DOCKER_HOST=unix:///run/ilex/proxy/docker.sock
Environment=WEB_ROOT=/opt/ilex/app/apps/web/browser
Environment=SETUP_TOKEN_FILE=/var/lib/ilex/app/setup-token
EnvironmentFile=/etc/ilex/app.env
WorkingDirectory=/opt/ilex/app/apps/server
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=5
UMask=0077
# Gives a running install, removal or restore time to start its service again.
TimeoutStopSec=2min

[Install]
WantedBy=multi-user.target
