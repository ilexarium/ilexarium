# /etc/systemd/system/laris-platform.service — REVIEW-REQUIRED (system/CLAUDE.md).
# The platform's containers — its database and the Docker socket proxy
# (/opt/laris/platform/compose.yml) — started at boot, before the app. Design:
# docs/plans/installer.md.

[Unit]
Description=Laris platform (database, Docker proxy)
Requires=docker.service
After=docker.service network-online.target systemd-tmpfiles-setup.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/docker compose --project-directory /opt/laris/platform --env-file /etc/laris/platform.env up -d --wait
ExecStop=/usr/bin/docker compose --project-directory /opt/laris/platform --env-file /etc/laris/platform.env stop
TimeoutStartSec=5min

[Install]
WantedBy=multi-user.target
