# /etc/systemd/system/laris.service — REVIEW-REQUIRED (system/CLAUDE.md).
# The app, as its own unprivileged user. Two kinds of settings (docs/plans/no_access_knowledge.md):
# the release's — facts about this version's files, below, replaced with every update — and the
# machine's, /etc/laris/app.env (root:laris 0640: where it listens, the database password),
# written once by the installer and never by an update. Design: docs/plans/installer.md.
#
# Deliberately without NoNewPrivileges, ProtectSystem, PrivateTmp and the like: they apply to
# everything the app starts too, and the app's privileged work happens in its root wrappers,
# started through sudo (which needs new privileges) — they write /etc, /mnt and /srv. The
# wrappers check everything themselves; the app gets no rights beyond sudo to them.

[Unit]
Description=Laris
Requires=laris-platform.service
After=laris-platform.service network-online.target
Wants=network-online.target

[Service]
User=laris
Group=laris
Environment=NODE_ENV=production
Environment=DOCKER_HOST=unix:///run/laris/proxy/docker.sock
Environment=WEB_ROOT=/opt/laris/app/apps/web/browser
Environment=SETUP_TOKEN_FILE=/var/lib/laris/app/setup-token
EnvironmentFile=/etc/laris/app.env
WorkingDirectory=/opt/laris/app/apps/server
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=5
UMask=0077
# Gives a running install, removal or restore time to start its service again.
TimeoutStopSec=2min

[Install]
WantedBy=multi-user.target
