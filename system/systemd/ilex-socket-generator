#!/bin/bash
# /usr/local/lib/systemd/system-generators/ilex-socket-generator — run by systemd as root, at boot
# and at every daemon-reload: where ilex.socket listens, from HOST and PORT in /etc/ilex/app.env
# (the machine's settings, the only place they are kept), as a drop-in in systemd's own folder
# for generated units. Settings that aren't an address and a port leave the socket without one:
# systemd refuses it, and the app with it.
set -u

SETTINGS=/etc/ilex/app.env

# A setting as systemd reads it: the last one, spaces around it and one pair of quotes taken off
# (the installer's app_setting).
setting() {
  local value
  value="$(sed -n "s/^[[:space:]]*$1=//p" "$SETTINGS" 2>/dev/null | tail -n1 | tr -d '\r')"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  if [[ "$value" =~ ^\"(.*)\"$ || "$value" =~ ^\'(.*)\'$ ]]; then value="${BASH_REMATCH[1]}"; fi
  printf '%s' "$value"
}

# The ListenStream lines for HOST $1 and PORT $2, with ::1 when $3 is yes (the machine has IPv6).
# The app checks what it is passed by the same rule (socketMismatch in the server): HOST (unset:
# 127.0.0.1, the app's default), and beside 127.0.0.1 or 0.0.0.0 also ::1, beside ::1 also
# 127.0.0.1 — "localhost" reaches the app whichever one a proxy picks. Fails for anything but an
# address and a port; only digits, dots and colons ever reach the unit.
listen_lines() {
  local host="${1:-127.0.0.1}" port="${2:-3000}" ipv6="$3"
  if [[ ! "$port" =~ ^[1-9][0-9]{0,4}$ ]] || ((port > 65535)); then return 1; fi
  if [[ "$host" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
    printf 'ListenStream=%s:%s\n' "$host" "$port"
    if [[ "$ipv6" == yes && ("$host" == 127.0.0.1 || "$host" == 0.0.0.0) ]]; then
      printf 'ListenStream=[::1]:%s\n' "$port"
    fi
  elif [[ "$host" =~ ^[0-9a-fA-F:.]+$ && "$host" == *:* ]]; then
    printf 'ListenStream=[%s]:%s\n' "$host" "$port"
    if [[ "$host" == ::1 ]]; then printf 'ListenStream=127.0.0.1:%s\n' "$port"; fi
  else
    return 1
  fi
}

main() {
  local normal="$1" lines ipv6=no
  if [[ -e /proc/net/if_inet6 ]]; then ipv6=yes; fi
  if ! lines="$(listen_lines "$(setting HOST)" "$(setting PORT)" "$ipv6")"; then
    printf 'ilex-socket-generator: HOST or PORT in %s is not an address and a port\n' "$SETTINGS" >&2
    return 0
  fi
  mkdir -p "$normal/ilex.socket.d"
  printf '[Socket]\n%s\n' "$lines" >"$normal/ilex.socket.d/listen.conf"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then main "$@"; fi
