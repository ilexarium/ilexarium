# /etc/systemd/system/ilex-backup.timer
# When backups run. The schedule the user chose replaces OnCalendar through a drop-in that
# `ilex-backup configure` writes (ilex-backup.timer.d/schedule.conf); the line below is the
# default (daily at 03:00). Enabled by `configure` once a plan exists.

[Unit]
Description=Ilexarium backups on schedule

[Timer]
OnCalendar=*-*-* 03:00:00
# Missed while the machine was off: run soon after it starts.
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
