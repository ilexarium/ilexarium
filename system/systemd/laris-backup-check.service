# /etc/systemd/system/laris-backup-check.service — REVIEW-REQUIRED (system/CLAUDE.md).
# A repository check (`borg check`; the first of each month also reads all data back), started by
# laris-backup-check.timer. Its result goes to /var/lib/laris/backups/runs.jsonl.

[Unit]
Description=Laris backup repository check
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/opt/laris/libexec/laris-backup.mts check-scheduled
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=24h
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
