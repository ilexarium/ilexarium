# A restore: started by `ilex-backup restore-start` (through the person's sudo) with the instance
# <restoreId> — a uuid, checked again by the program, which reads the request from its own
# root-only file. Its own unit, not a child of the app: it goes on if the app stops or restarts.
# Its phases, output and result go to its job file, /var/lib/ilex/backups/jobs/<id>.jsonl.

[Unit]
Description=Ilexarium restore
After=docker.service local-fs.target
Wants=docker.service

[Service]
Type=oneshot
ExecStart=/opt/ilex/libexec/ilex-backup.mts restore-run %i
# A big photo library takes long; stopping it puts the folders back and starts the app again.
TimeoutStartSec=24h
TimeoutStopSec=5min
KillMode=mixed
# It writes where it restores to (anywhere but the system's folders), its state and the lock.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
