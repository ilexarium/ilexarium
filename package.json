{
  "name": "ilex",
  "version": "0.2.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:shared": "npm run build -w @ilex/shared -w @ilex/i18n",
    "build": "npm run build:shared && npm run build -w @ilex/server -w @ilex/web",
    "dev:shared": "npm run dev -w @ilex/shared",
    "dev:server": "npm run build:shared && npm run start:dev -w @ilex/server",
    "dev:web": "npm run build:shared && npm run start -w @ilex/web",
    "db:up": "dev/compose.sh up -d",
    "db:down": "dev/compose.sh --profile server down",
    "server:up": "dev/compose.sh --profile server up -d --build server",
    "srv": "dev/compose.sh exec -u dev server",
    "dev:srv": "npm run db:up && npm run server:up && npm run srv -- npm run dev:server",
    "test": "npm run build:shared && npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present && npm run lint:programs",
    "lint:programs": "tsc -p system/programs",
    "format": "prettier --write . '!**/.dev/**'",
    "format:check": "prettier --check . '!**/.dev/**'",
    "db:migrate": "npm run db:migrate -w @ilex/server",
    "test:e2e": "npm run build:shared && npm run test:e2e -w @ilex/server",
    "release": "node scripts/release.mjs",
    "release:key": "node scripts/release-key.mjs",
    "release:sign": "node scripts/sign-release.mjs",
    "release:publish": "node scripts/publish-release.mjs",
    "release:upload": "node scripts/upload-release.mjs",
    "ship": "node scripts/ship.mjs"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
