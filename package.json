{
  "name": "homelab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:shared": "npm run build -w @homelab/shared",
    "build": "npm run build:shared && npm run build -w @homelab/server -w @homelab/web",
    "dev:shared": "npm run dev -w @homelab/shared",
    "dev:server": "npm run build:shared && npm run start:dev -w @homelab/server",
    "dev:web": "npm run build:shared && npm run start -w @homelab/web",
    "db:up": "docker compose -f dev/compose.dev.yml up -d",
    "db:down": "docker compose -f dev/compose.dev.yml down",
    "test": "npm run build:shared && npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.8.1"
  }
}
